# Python
.venv/
__pycache__/
*.pyc

# Secrets: API keys live here, never commit
.env
.env.*
!.env.example

# IDE
.idea/
.DS_Store

# Web app
web/node_modules/
web/dist/
web/*.tsbuildinfo

# Service data (SQLite and result blobs)
data/
web/shots/

# Deployment secrets
deploy/*.env
!deploy/platform.env.example

# Synthetic data: libraries are committed (small, immutable, content-hashed); their work folders, LLM caches and training exports are regenerable
libraries/*.work/
runs/training/
runs/llm_cache/
runs/libraries/
runs/training/

# Local run outputs (regenerable)
runs/jev_cache/
runs/jev_cache_mock/
runs/jev_sim/
runs/ui_shots/
runs/walk_library/
