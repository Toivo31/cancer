    ]
   },
   {
    "id": "book_surgery",
    "kind": "step",
    "test": "surgery_booking",
    "when": "treatment == 'surgery'",
    "label": "Waiting for surgery",
    "after": [
     "mdt"
    ]
   },
   {
    "id": "book_rt",
    "kind": "step",
    "test": "radiotherapy_booking",
    "when": "treatment == 'radiotherapy'",
    "label": "Waiting for radiotherapy",
    "after": [
     "mdt"
    ]
   },
   {
    "id": "treat",
    "kind": "exit",
    "test": "treatment",
    "outcome": "treatment",
    "label": "Treatment starts",
    "after": [
