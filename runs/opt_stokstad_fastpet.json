    "id": "pet_early_route",
    "kind": "step",
    "label": "PET-CT ordered at first visit",
    "after": [
     "visit"
    ]
   },
   {
    "id": "pet_early",
    "kind": "step",
    "test": "pet_ct",
    "label": "PET-CT",
    "after": [
