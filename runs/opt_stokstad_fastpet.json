   {
    "id": "exercise",
    "kind": "step",
    "label": "Exercise test done",
    "after": [
     "visit"
    ],
    "after_optional": [
     "ex_timing",
     "ex_early",
     "ex_late"
    ]
   },
   {
    "id": "diagnosis",
    "kind": "milestone",
    "milestone": "diagnosis",
    "label": "Diagnostic workup complete",
    "after": [
     "sampling_done",
     "pet"
    ]
   },
   {
    "id": "mdt",
    "kind": "step",
    "test": "tumour_board",
    "label": "Tumour board",
    "after": [
