 "flowchart_before": {
  "id": "baseline",
  "nodes": [
   {
    "id": "first_contact",
    "kind": "choice",
    "label": "Nurse or GP first",
    "options": [
     "nurse_visit",
     "gp_visit"
    ]
   },
   {
    "id": "nurse_visit",
    "kind": "step",
    "test": "nurse_assessment",
