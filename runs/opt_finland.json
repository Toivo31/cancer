    "fast_track": true
   },
   {
    "id": "spec_visit",
    "kind": "step",
    "test": "specialist_visit",
    "label": "Specialist visit",
    "after": [
     "triage"
    ]
   },
   {
    "id": "discharge_spec",
    "kind": "exit",
    "when": "not spec_visit",
    "outcome": "discharged",
    "label": "Discharged by specialist",
    "after": [
     "spec_visit"
    ]
   },
   {
    "id": "ct",
    "kind": "step",
    "test": "chest_ct",
    "when": "spec_visit",
    "label": "CT chest",
    "after": [
     "spec_visit"
    ]
   },
   {
    "id": "discharge_ct",
    "kind": "exit",
    "when": "not ct",
    "outcome": "discharged",
    "label": "Discharged after negative CT",
    "after": [
     "ct"
    ]
   },
   {
    "id": "sample_choice",
    "kind": "choice",
    "when": "ct",
    "label": "Choose sampling method",
    "after": [
     "ct"
    ],
    "options": [
     "bronch",
     "ttnb"
    ]
   },
   {
    "id": "bronch",
    "kind": "step",
    "test": "bronchoscopy",
    "retry": {
     "max": 0,
     "true": "nondiagnostic",
     "fallback": "ttnb"
    },
    "label": "Bronchoscopy"
   },
   {
    "id": "ttnb",
    "kind": "step",
    "test": "ttnb",
    "label": "Needle biopsy"
   },
   {
    "id": "sampling_done",
    "kind": "step",
    "label": "Sampling finished",
    "after_optional": [
     "sample_choice",
     "bronch",
     "ttnb"
    ]
   },
   {
    "id": "diagnosis",
    "kind": "milestone",
    "milestone": "diagnosis",
    "label": "Tissue diagnosis",
    "after": [
     "sampling_done"
    ]
   },
   {
    "id": "pet",
    "kind": "step",
    "test": "pet_ct",
    "when": "bronch is not False and ttnb is not False",
    "label": "PET-CT",
    "after": [
     "sampling_done"
    ]
   },
   {
    "id": "mdt",
    "kind": "step",
    "test": "tumour_board",
    "label": "Tumour board",
    "after": [
     "sampling_done"
    ],
    "after_optional": [
     "pet"
    ]
   },
   {
    "id": "book_treat",
    "kind": "step",
    "test": "treatment_booking",
    "when": "bronch or ttnb or (pet and bronch is not False and ttnb is not False)",
    "label": "Waiting for treatment slot",
    "after": [
     "mdt"
    ]
   },
   {
    "id": "discharge_mdt",
    "kind": "exit",
    "when": "not (bronch or ttnb or (pet and bronch is not False and ttnb is not False))",
    "outcome": "discharged",
    "label": "No cancer (board)",
    "after": [
     "mdt"
    ]
   },
   {
    "id": "treat",
    "kind": "exit",
    "outcome": "treatment",
    "label": "Treatment starts",
    "after": [
     "book_treat"
    ]
   }
  ],
  "policy": {
   "first_contact": {
    "prefer": [
     "gp_visit"
    ],
    "note": "standardised by optimiser"
   },
   "sample_choice": {
    "rules": [
     {
      "when": "location == 'central'",
      "choose": "bronch"
     }
    ],
    "mix": {
     "bronch": 0.35,
     "ttnb": 0.65
    },
    "source": "assumption"
   }
  },
  "description": "Finnish sequential pathway (nurse/GP, CXR, referral, specialist, CT, sampling, PET-CT, board, treatment)"
 }
}