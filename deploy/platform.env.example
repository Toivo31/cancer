# Copy to deploy/platform.env (git-ignored, keep it chmod 600) and fill in. No quotes.

# REQUIRED unless PATHWAY_PUBLIC_READ=1. At least 16 characters:  openssl rand -hex 24
PATHWAY_ACCESS_TOKEN=

# Visitors without the token may look (templates, projects, runs) but not change or start anything.
PATHWAY_PUBLIC_READ=1
# Freeze everything, token or not (use for the judging period once the instance is seeded).
PATHWAY_READ_ONLY=

# Limits (spec 03). Two workers match the 2 CPUs the container is given.
PATHWAY_MAX_JOBS=2
PATHWAY_MAX_PATIENTS=50000
PATHWAY_JOB_SECONDS=900
PATHWAY_MIN_FREE_MB=500

# JEV servers the service may call: host or host:port, comma separated. Empty = decision policy "http" refused.
JEV_ALLOWED_HOSTS=
JEV_DEFAULT_URL=

# Optional wording of the synthetic-data notice.
PATHWAY_DATA_NOTICE=

# Reverse proxy (profile "proxy"): site addresses for Caddy. A domain gets automatic HTTPS; ":80" / ":8080" is plain HTTP by port.
PLATFORM_SITE=:80
LIVE_SITE=:8080
