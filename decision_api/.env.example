# Backend-only configuration. Never commit the real .env or key file.
BIRCH_API_URL=https://cancer123--birch-decision-1138-inference-web.us-east.modal.run
BIRCH_API_KEY=
# Prefer an out-of-repository key file when available:
# BIRCH_API_KEY_FILE=/private/path/to/key
BIRCH_DECISION_MODE=live
# Local maintenance switch; does not disable other direct Modal clients:
BIRCH_DECISION_PAUSED=0
# Set your deployed demo hostname when hosting the proxy publicly:
BIRCH_ALLOWED_HOSTS=127.0.0.1,localhost,::1
